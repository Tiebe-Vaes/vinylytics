# Postgres connection string (Neon on Vercel, or the docker-compose db)
DATABASE_URL=
# From developer.spotify.com/dashboard (the app owner needs Spotify Premium)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the app's redirect URI exactly. Spotify rejects "localhost": use 127.0.0.1
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Bearer token the sync job sends to /api/cron/sync. Generate the same way
CRON_SECRET=
# Optional: your Spotify user id. When set, only this account can ever sign in
OWNER_SPOTIFY_ID=
# Optional: IANA timezone for day and hour stats (default UTC), e.g. Europe/Brussels
TIMEZONE=
# Optional: Last.fm API key, used for genre tags
LASTFM_API_KEY=
