{
  "name": "vinylytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-local.mjs",
    "local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-local.mjs --mine",
    "vercel-build": "node scripts/migrate.mjs && next build",
    "start:docker": "node scripts/migrate.mjs && next start",
    "db:generate": "drizzle-kit generate",
    "build:browser": "node scripts/browser.mjs build",
    "dev:browser": "node scripts/browser.mjs dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/big-shoulders": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "description": "Your Spotify history, pressed as records. Self-hosted listening stats with eras, share cards and the stats nobody else shows.",
  "keywords": [
    "spotify",
    "listening-history",
    "stats",
    "self-hosted",
    "nextjs"
  ],
  "license": "MIT"
}
