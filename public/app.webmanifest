{
  "id": "/app/",
  "name": "Vinylytics",
  "short_name": "Vinylytics",
  "description": "Your Spotify listening history, pressed as records. Stored only on this device.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "background_color": "#0f0f10",
